@page
@model FriendsByCountryModel

<div class="container mt-5">
    <h1>Friends by Country</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Country</th>
                <th>Friend Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.FriendsByCountry)
            {
                <tr>
                    <td>@group.Country</td>
                    <td>@group.Count</td>
                </tr>
            }
        </tbody>
    </table>
</div>